{
  "name": "vancouver-public-art",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Map and catalogue of Vancouver's 750 public artworks from the City's open data: filters, search, detail pages with artist bios, a visited list. React 19 + TanStack Query + React Router + Leaflet.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview",
    "a11y": "node scripts/a11y.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.106.1",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "playwright": "1.63.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
